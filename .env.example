# Para o SITE aparecer na Vercel nao e preciso nenhuma variavel.
# As demais ativam o atendimento por WhatsApp e o painel /admin (veja o README).
# Nunca coloque valores reais neste arquivo: ele vai para o GitHub. Use o painel da Vercel ou .env.local.
# Variaveis NEXT_PUBLIC_* ficam visiveis no navegador; nunca use esse prefixo para segredos.

# ---------- Site ----------
# Numero do WhatsApp Business usado no botao do site (so digitos, com DDI). Ex.: 5521999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL publica do site (usada nos links do painel e no SEO)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Chave do Google Maps (Maps Embed API) para o mapa do site. Opcional: sem ela o mapa usa o embed simples.
# Lida no build: ao alterar, faca um novo deploy.
GOOGLE_MAPS_API_KEY=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto qualquer que voce escolhe; o mesmo valor vai no campo "Verify token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Versao da Graph API (ajuste se a Meta descontinuar)
WHATSAPP_GRAPH_VERSION=v23.0

# ---------- Aviso para a oficina ----------
# Numeros que recebem cada lead novo, separados por virgula (so digitos, com DDI)
WORKSHOP_NOTIFY_NUMBERS=
# template = usa template aprovado (funciona a qualquer hora)
# text     = mensagem livre (so chega se o numero falou com o bot nas ultimas 24h)
NOTIFY_MODE=template
NOTIFY_TEMPLATE=novo_orcamento

# ---------- Painel /admin ----------
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Persistencia (obrigatorio na Vercel) ----------
# Sem isso os dados ficam em .data/db.json (so serve para desenvolvimento local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
